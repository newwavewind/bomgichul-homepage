# Google Search Console 사이트 소유 확인 (HTML 태그 방식)
# GOOGLE_SITE_VERIFICATION=your_google_verification_token

# Custom Domain 활성화 후에는 https://auth.bomgichul.com 사용 (supabase/CUSTOM_DOMAIN.md)
NEXT_PUBLIC_SUPABASE_URL=https://your-project-ref.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your_supabase_anon_key

# 앱 오류신고·피드백 → 커뮤니티 게시글 등록용 (Dashboard → Settings → API → service_role)
SUPABASE_SERVICE_ROLE_KEY=your_supabase_service_role_key

# 매일 아침 뉴스 cron (/api/cron/news) 인증용 — Anthropic API 키는 필요 없음
CRON_SECRET=your_random_cron_secret
